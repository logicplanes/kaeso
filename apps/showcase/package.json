{
  "name": "kaeso-showcase",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "The showcase of the Kaeso UI library at ui.kaeso.app.",
  "license": "MIT",
  "author": "Devin Oldenburg",
  "homepage": "https://ui.kaeso.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logicplanes/kaeso.git",
    "directory": "apps/showcase"
  },
  "bugs": {
    "url": "https://github.com/logicplanes/kaeso/issues"
  },
  "scripts": {
    "gen": "node scripts/gen-pages.mjs",
    "dev": "node scripts/gen-pages.mjs && astro dev",
    "build": "node scripts/gen-pages.mjs && astro build && node ../../scripts/check-site.mjs dist https://ui.kaeso.app",
    "preview": "astro preview",
    "lint": "oxlint --deny-warnings .",
    "test": "node --test 'scripts/*.test.mjs'",
    "typecheck": "node scripts/gen-pages.mjs && tsc -p tsconfig.json && tsc -p tsconfig.e2e.json",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/mdx": "8.1.1",
    "@astrojs/react": "7.1.1",
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@logicplanes/kaeso-tokens": "workspace:*",
    "@logicplanes/kaeso-ui": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.89.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3"
  }
}
