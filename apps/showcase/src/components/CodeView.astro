---
import { Code } from "astro:components";
import type { CodeLanguage } from "astro";
import { codeTheme } from "~/lib/code-theme";
import { docsText } from "~/lib/locale";
import { docsLangOf } from "~/lib/languages";
interface Props {
  code: string;
  lang?: CodeLanguage;
  class?: string;
  copy?: boolean;
}
const { code, lang = "tsx", class: className, copy = true } = Astro.props;
const copyLabel = docsText(docsLangOf(Astro.params.lang), "Copy code");
---

<div class:list={["group relative rounded-well bg-fill-1", className]} data-code-view>
  <Code
    code={code}
    lang={lang}
    theme={codeTheme}
    class="scrollbar-quiet overflow-x-auto px-16 py-16 text-small leading-20 mono"
    style="background: transparent"
  />
  {copy && (
    <button
      type="button"
      data-copy={code}
      aria-label={copyLabel}
      class="absolute top-8 right-8 inline-flex size-32 items-center justify-center rounded-pill material-ghost text-fg-secondary opacity-0 transition-control focus-ring group-hover:opacity-100 focus-visible:opacity-100"
    >
      <svg
        viewBox="0 0 24 24"
        class="size-16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M9 15c0-2.83 0-4.24.88-5.12C10.76 9 12.17 9 15 9h1c2.83 0 4.24 0 5.12.88.88.88.88 2.29.88 5.12v1c0 2.83 0 4.24-.88 5.12-.88.88-2.29.88-5.12.88h-1c-2.83 0-4.24 0-5.12-.88C9 20.24 9 18.83 9 16z" />
        <path d="M17 9c0-2.96-.04-4.49-.9-5.53a4 4 0 0 0-.57-.58C14.4 2 12.73 2 9.4 2 6.06 2 4.4 2 3.28 2.9a4 4 0 0 0-.57.57C2 4.6 2 6.27 2 9.6s0 5 .9 6.12c.17.21.36.4.57.57C4.51 17.14 6.04 17 9 17" />
      </svg>
    </button>
  )}
</div>
<script>
  import { docsText } from "~/lib/locale";
  import { docsLangOf } from "~/lib/languages";

  const resets = new WeakMap<HTMLButtonElement, ReturnType<typeof setTimeout>>();

  document.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-copy]");
    if (!btn) return;
    try {
      await navigator.clipboard.writeText(btn.dataset.copy ?? "");
    } catch {
      return;
    }
    const lang = docsLangOf(document.documentElement.lang);
    btn.setAttribute("aria-label", docsText(lang, "Copied"));
    btn.dataset.copied = "";
    clearTimeout(resets.get(btn));
    resets.set(
      btn,
      setTimeout(() => {
        btn.setAttribute("aria-label", docsText(lang, "Copy code"));
        delete btn.dataset.copied;
        resets.delete(btn);
      }, 1200),
    );
  });
</script>
