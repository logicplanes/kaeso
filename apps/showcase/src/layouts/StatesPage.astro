---
import Base from "./Base.astro";
import { docsText } from "~/lib/locale";
import { docsLangOf, localizedPath } from "~/lib/languages";
import type { DemoPage } from "~/lib/demos";
interface Props {
  page: DemoPage;
}
const { page } = Astro.props;
const lang = docsLangOf(Astro.params.lang);
---

<Base
  title={`${page.title} · ${docsText(lang, "States")}`}
  description={`Every state of ${page.title}, in light and dark.`}
  path={`/components/${page.slug}/states`}
>
  <main class="min-h-dvh bg-panel" data-states-page={page.slug}>
    <header class="flex h-52 items-center gap-12 px-24 hairline-b">
      <a href={localizedPath(lang, `/components/${page.slug}`)} class="text-body font-medium text-fg-secondary hover:text-fg">
        ‹ {page.title}
      </a>
      <span class="text-small text-fg-tertiary">{docsText(lang, "All states · light and dark")}</span>
    </header>
    <div class="grid w-max min-w-full grid-cols-[max-content_max-content]">
      <section data-theme="light" data-states-theme="light" class="bg-panel p-32 text-fg" aria-label={docsText(lang, "Light")}>
        <slot name="light" />
      </section>
      <section data-theme="dark" data-states-theme="dark" class="bg-panel p-32 text-fg" aria-label={docsText(lang, "Dark")}>
        <slot name="dark" />
      </section>
    </div>
  </main>
</Base>
