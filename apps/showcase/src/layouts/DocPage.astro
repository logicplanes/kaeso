---
import Shell from "./Shell.astro";
import CodeView from "~/components/CodeView.astro";
import CopyPage from "~/components/CopyPage";
import { docsText, inlineCode } from "~/lib/locale";
import { docsLangOf } from "~/lib/languages";
import { sourceUrl } from "~/lib/release";
import type { DemoPage, DocPageData } from "~/lib/demos";
interface Props {
  page: DemoPage;
  doc: DocPageData;
}
const { page, doc } = Astro.props;
const lang = docsLangOf(Astro.params.lang);
const t = (s: string) => docsText(lang, s);
const description = page.description.replace(/\s+/g, " ").trim();
const markdown = [
  `# ${page.title}`,
  "",
  page.description,
  "",
  "```tsx",
  doc.importLine,
  "```",
  "",
  ...page.examples.flatMap((e) => [`## ${e.title}`, "", ...(e.description ? [e.description, ""] : []), "```tsx", e.code, "```", ""]),
].join("\n");
---

<Shell title={page.title} description={description} path={`/components/${page.slug}`}>
  <article class="mx-auto w-full max-w-960 px-24 pt-48 pb-96 md:px-40">
    <header class="flex flex-col gap-12">
      <h1 class="text-title-lg font-semibold text-fg text-balance">{page.title}</h1>
      <p class="max-w-prose text-body-lg font-regular text-fg-secondary text-pretty" set:html={inlineCode(t(description))} />
      <div class="mt-4 flex flex-wrap items-center gap-8">
        <CopyPage client:idle markdown={markdown} />
        <a
          href={sourceUrl(`packages/ui/src/${page.source ?? `components/${page.slug}`}`)}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-32 items-center gap-6 rounded-pill px-12 text-body font-medium material-ghost transition-control focus-ring"
        >
          <span>{t("View source")}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <div class="mt-40">
      <slot name="primary" />
    </div>
    <CodeView class="mt-12" code={doc.importLine} />

    {doc.props.length > 0 && (
      <section class="mt-64">
        <h2 id="props" class="scroll-mt-24 text-title-sm font-semibold text-fg">
          {t("Props")}
        </h2>
        <ul class="mt-12 flex flex-col">
          {doc.props.map((p) => (
            <li class="flex flex-col gap-4 py-12 hairline-b md:flex-row md:gap-24">
              <code class="w-200 shrink-0 text-small font-medium text-fg mono">{p.name}</code>
              <div class="flex min-w-0 flex-1 flex-col gap-4">
                <span class="text-small text-fg-secondary mono break-words">
                  {p.type}
                  {p.default && <span class="text-fg-tertiary"> = {p.default}</span>}
                </span>
                {p.description && <p class="max-w-prose text-body text-fg-secondary text-pretty" set:html={inlineCode(t(p.description))} />}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Shell>
