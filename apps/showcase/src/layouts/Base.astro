---
import "~/styles/docs.css";
import { themeScript } from "@logicplanes/kaeso-ui";
import { docsText } from "~/lib/locale";
import { DOCS_LANGUAGES, docsLangOf, docsLangScript, localizedPath } from "~/lib/languages";
import { docsThemeSwapScript } from "~/lib/theme";
import { ClientRouter } from "astro:transitions";
interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  path?: string | undefined;
  notFound?: boolean;
  noindex?: boolean;
}
const {
  title,
  description = "Kaeso's UI library: every component in every state, in light and dark.",
  bodyClass,
  path,
  notFound = false,
  noindex = false,
} = Astro.props;
const lang = docsLangOf(Astro.params.lang);
const shownTitle = docsText(lang, title);
const fullTitle = shownTitle === "Kaeso UI" ? shownTitle : `${shownTitle} · Kaeso UI`;
const shownDescription = docsText(lang, description);
const site = Astro.site?.origin ?? "https://ui.kaeso.app";
const href = (l: (typeof DOCS_LANGUAGES)[number]["value"]) => `${site}${path === undefined ? "" : localizedPath(l, path)}`;
const indexed = path !== undefined && !notFound && !noindex;
const OG_LOCALES = { en: "en_US", de: "de_DE", "zh-CN": "zh_CN" } as const;
const image = `${site}/og.png`;
const website =
  indexed && path === "/"
    ? JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "Kaeso UI",
        url: href(lang),
        inLanguage: lang,
        description: shownDescription,
      }).replace(/</g, "\\u003c")
    : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {(path !== undefined || notFound) && <script is:inline set:html={docsLangScript(lang, notFound)} />}
    <title>{fullTitle}</title>
    <meta name="description" content={shownDescription} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-dark-32.png" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {indexed && <link rel="canonical" href={href(lang)} />}
    {indexed && DOCS_LANGUAGES.map((l) => <link rel="alternate" hreflang={l.value} href={href(l.value)} />)}
    {indexed && <link rel="alternate" hreflang="x-default" href={href("en")} />}
    {!indexed && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kaeso UI" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={shownDescription} />
    {indexed && <meta property="og:url" content={href(lang)} />}
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    {DOCS_LANGUAGES.filter((l) => l.value !== lang).map((l) => (
      <meta property="og:locale:alternate" content={OG_LOCALES[l.value]} />
    ))}
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kaeso" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={shownDescription} />
    <meta name="twitter:image" content={image} />
    {website && <script is:inline type="application/ld+json" set:html={website} />}
    <script is:inline set:html={themeScript} />
    <script is:inline set:html={docsThemeSwapScript} />
    <ClientRouter fallback="swap" />
  </head>
  <body class={bodyClass} transition:animate="none">
    <slot />
  </body>
</html>
