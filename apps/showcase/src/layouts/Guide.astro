---
import Shell from "./Shell.astro";
import GuideBody from "./GuideBody.astro";
import { docsText } from "~/lib/locale";
import { docsLangOf } from "~/lib/languages";
interface Props {
  title: string;
  description: string;
  path: string;
  toc: [string, string][];
  wide?: boolean | undefined;
}
const { title, description, path, toc, wide } = Astro.props;
const lang = docsLangOf(Astro.params.lang);
---

<Shell title={title} description={description} path={path}>
  <GuideBody title={docsText(lang, title)} description={docsText(lang, description)} toc={toc} wide={wide}>
    <slot />
  </GuideBody>
</Shell>
