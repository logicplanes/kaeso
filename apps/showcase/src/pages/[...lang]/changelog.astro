---
import { getEntry } from "astro:content";
import { Badge, Separator } from "@logicplanes/kaeso-ui";
import { formatDate, parseISODate, setFormatLocale } from "@logicplanes/kaeso-ui/format";
import Guide from "~/layouts/Guide.astro";
import ChangelogEntry from "~/components/ChangelogEntry.astro";
import { docsText, prepareDocsPage } from "~/lib/locale";
import { languagePaths } from "~/lib/languages";

export const getStaticPaths = languagePaths;
const lang = await prepareDocsPage(Astro.params.lang);
const t = (s: string) => docsText(lang, s);
const changelog = await getEntry("changelog", "kaeso");
if (!changelog) throw new Error("the changelog collection is empty: CHANGELOG.md wasn't loaded");
const { repository, unreleased, releases } = changelog.data;
const toc: [string, string][] = [
  ...(unreleased ? [[unreleased.id, t("Unreleased")] as [string, string]] : []),
  ...releases.map((r) => [r.id, r.version] as [string, string]),
];
setFormatLocale(lang);
const day = (iso: string) => {
  const date = parseISODate(iso);
  return date ? formatDate(date) : iso;
};
const since = (version: string) => t("Changes since {version}").replace("{version}", version);
const link = "inline-flex items-center gap-4 rounded-code text-fg-secondary transition-control hover:text-fg focus-ring";
---

<Guide
  path="/changelog"
  title="Changelog"
  description="Every change to Kaeso, the UI library included, release by release."
  toc={toc}
  wide
  feed={repository ? { title: t("Kaeso releases"), href: `${repository}/releases.atom` } : undefined}
>
  <div class="flex max-w-prose flex-col gap-40">
    {lang !== "en" && <p class="-mt-16 text-body text-fg-secondary text-pretty">{t("The changelog is written in English.")}</p>}
    {unreleased && (
      <section aria-labelledby={unreleased.id} class="flex flex-col gap-16">
        <div class="flex flex-col gap-4">
          <h2 id={unreleased.id} class="scroll-mt-40 text-title font-semibold text-fg">
            {t("Unreleased")}
          </h2>
          <div class="flex flex-wrap items-center gap-x-16 gap-y-4 text-body text-fg-secondary">
            <span>{t("Not in a release yet; these changes come with the next one.")}</span>
            {unreleased.compare && unreleased.since && (
              <a href={unreleased.compare} target="_blank" rel="noopener noreferrer" class={link}>
                {since(unreleased.since)}
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </div>
        <ChangelogEntry entry={unreleased} />
      </section>
    )}
    {releases.map((release, i) => (
      <>
        {(i > 0 || unreleased) && <Separator />}
        <section aria-labelledby={release.id} class="flex flex-col gap-16">
          <div class="flex flex-col gap-4">
            <div class="flex flex-wrap items-center gap-x-12 gap-y-4">
              <h2 id={release.id} class="scroll-mt-40 text-title font-semibold text-fg tabular">
                {release.version}
              </h2>
              {release.latest && <Badge tone="ink">{t("Latest")}</Badge>}
              {release.prerelease && <Badge tone="outline">{t("Pre-release")}</Badge>}
              {release.yanked && <Badge tone="warning">{t("Withdrawn")}</Badge>}
            </div>
            <div class="flex flex-wrap items-center gap-x-16 gap-y-4 text-body text-fg-secondary">
              {release.date && <time datetime={release.date}>{day(release.date)}</time>}
              {release.url && (
                <a href={release.url} target="_blank" rel="noopener noreferrer" class={link}>
                  {t("Release on GitHub")}
                  <span aria-hidden="true">↗</span>
                </a>
              )}
              {release.compare && release.previous && (
                <a href={release.compare} target="_blank" rel="noopener noreferrer" class={link}>
                  {since(release.previous)}
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </div>
          <ChangelogEntry entry={release} />
        </section>
      </>
    ))}
    {!unreleased && !releases.length && <p class="text-body-lg text-fg-secondary">{t("No releases yet.")}</p>}
  </div>
</Guide>
