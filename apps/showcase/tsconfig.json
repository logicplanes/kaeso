{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["astro/client"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "@logicplanes/kaeso-ui": ["../../packages/ui/src/index.ts"],
      "@logicplanes/kaeso-ui/format": ["../../packages/ui/src/format/index.ts"],
      "@logicplanes/kaeso-ui/i18n": ["../../packages/ui/src/i18n/index.tsx"],
      "@logicplanes/kaeso-ui/markdown": ["../../packages/ui/src/components/markdown/index.ts"],
      "@logicplanes/kaeso-ui/playground": ["../../packages/ui/src/components/playground/index.ts"],
      "@logicplanes/kaeso-ui/blocks/*": ["../../packages/ui/src/blocks/*/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
