{
  "name": "kaeso-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The web console for the Kaeso gateway.",
  "license": "MIT",
  "author": "Devin Oldenburg",
  "homepage": "https://kaeso.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logicplanes/kaeso.git",
    "directory": "apps/console"
  },
  "bugs": {
    "url": "https://github.com/logicplanes/kaeso/issues"
  },
  "scripts": {
    "generate": "node scripts/gen-api.mjs && node scripts/gen-routes.mjs",
    "dev": "pnpm generate && vite",
    "build": "pnpm generate && tsc -b && vite build && node scripts/budget.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "pnpm generate && tsc -b",
    "test": "pnpm generate && vitest run --coverage",
    "test:watch": "pnpm generate && vitest",
    "i18n": "node scripts/i18n.mjs",
    "licenses:check": "node scripts/licenses.mjs",
    "e2e": "pnpm generate && playwright test",
    "stack:up": "node scripts/stack.mjs up",
    "stack:down": "node scripts/stack.mjs down",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@logicplanes/kaeso-ui": "workspace:*",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.42",
    "marked": "18.0.14",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@redocly/openapi-core": "1.34.20",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-generator": "1.167.41",
    "@tanstack/router-plugin": "1.168.43",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "happy-dom": "21.0.1",
    "openai": "7.32.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
