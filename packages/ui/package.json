{
  "name": "@logicplanes/kaeso-ui",
  "version": "0.3.7",
  "description": "Kaeso's UI library: React components on Base UI, Tailwind CSS v4 and the Kaeso tokens.",
  "license": "MIT",
  "author": "Devin Oldenburg",
  "homepage": "https://ui.kaeso.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logicplanes/kaeso.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/logicplanes/kaeso/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "kaeso",
    "react",
    "components",
    "base-ui",
    "tailwindcss",
    "design-system"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./format": {
      "types": "./dist/types/format/index.d.ts",
      "import": "./dist/format.js"
    },
    "./theme": {
      "types": "./dist/types/theme/index.d.ts",
      "import": "./dist/theme.js"
    },
    "./utils": {
      "types": "./dist/types/utils/index.d.ts",
      "import": "./dist/utils.js"
    },
    "./i18n": {
      "types": "./dist/types/i18n/index.d.ts",
      "import": "./dist/i18n.js"
    },
    "./blocks/*": {
      "types": "./dist/types/blocks/*/index.d.ts",
      "import": "./dist/blocks/*.js"
    },
    "./ai/component-registry.json": "./ai/component-registry.json",
    "./charts/*": {
      "types": "./dist/types/components/charts/*.d.ts",
      "import": "./dist/components/charts/*.js"
    },
    "./kaeso/*": {
      "types": "./dist/types/components/kaeso/*.d.ts",
      "import": "./dist/components/kaeso/*.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/types/components/*/index.d.ts",
      "import": "./dist/components/*.js"
    }
  },
  "files": [
    "dist",
    "ai",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "foundations"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/build-css.mjs && node scripts/registry.mjs && node scripts/references.mjs && node scripts/budgets.mjs",
    "lint": "oxlint --deny-warnings . && node scripts/lint.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run --coverage"
  },
  "peerDependencies": {
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/react": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@logicplanes/kaeso-tokens": "workspace:*",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.20",
    "clsx": "2.1.1",
    "d3-array": "3.2.4",
    "d3-sankey": "0.12.3",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "d3-time": "3.1.0",
    "marked": "18.1.1",
    "react-day-picker": "9.14.0",
    "shiki": "4.5.0",
    "tailwind-merge": "3.7.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/d3-array": "3.2.2",
    "@types/d3-sankey": "0.12.5",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/d3-time": "3.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "happy-dom": "21.0.1",
    "oxlint": "1.88.0",
    "react": "19.3.1",
    "react-docgen-typescript": "2.4.0",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
