{
  "name": "kaeso",
  "description": "Kaeso identity and UI are monochrome on pure white and pure black. Light mode is built on #ffffff and dark mode on #000000; text and primary fills sit one step off pure (#0a0a0a ink, #fafafa paper). Color appears only in data visualization and semantic status marks. The full component token set lives in @logicplanes/kaeso-ui.",
  "rules": {
    "forbiddenChromeColors": [],
    "serif": false,
    "transparentControls": false,
    "decorativeAutoplay": false,
    "pillControls": true,
    "chromaticInterface": false
  },
  "color": {
    "light": {
      "canvas": "#ffffff",
      "surface": "#fafafa",
      "muted": "#f5f5f5",
      "text": "#0a0a0a",
      "textSecondary": "#666666",
      "textDisabled": "#b8b8b8",
      "border": "#e5e5e5",
      "borderEmphasized": "#d4d4d4",
      "ink": "#0a0a0a",
      "onStrong": "#ffffff",
      "focus": "#0a0a0a"
    },
    "dark": {
      "canvas": "#000000",
      "surface": "#0a0a0a",
      "muted": "#141414",
      "text": "#fafafa",
      "textSecondary": "#a3a3a3",
      "textDisabled": "#4d4d4d",
      "border": "#222222",
      "borderEmphasized": "#333333",
      "ink": "#fafafa",
      "onStrong": "#000000",
      "focus": "#fafafa"
    }
  },
  "contrast": {
    "target": "WCAG 2.2 AA",
    "minimumBody": 4.5,
    "minimumLarge": 3,
    "pairs": {
      "lightPrimary": 19.8,
      "lightSecondary": 5.74,
      "darkPrimary": 20.12,
      "darkSecondary": 8.33
    }
  },
  "typography": {
    "display": {
      "family": "Inter",
      "weight": 600,
      "letterSpacingEm": -0.03,
      "fallbacks": "ui-sans-serif, system-ui, sans-serif",
      "source": "https://rsms.me/inter/"
    },
    "body": {
      "family": "Inter",
      "weights": [400, 500, 600],
      "features": ["cv11", "ss01", "ss03"],
      "fallbacks": "ui-sans-serif, system-ui, sans-serif",
      "source": "https://rsms.me/inter/"
    },
    "code": {
      "family": "Geist Mono",
      "fallbacks": "ui-monospace, SFMono-Regular, monospace"
    },
    "wordmark": {
      "construction": "custom-geometry",
      "transform": "uppercase",
      "liveText": false,
      "outlinedAsset": "../logo/svg/wordmark-current.svg"
    },
    "scale": [
      {
        "label": "Display",
        "token": "display",
        "sizePx": 40,
        "lineHeightPx": 44,
        "lineHeight": 1.1,
        "letterSpacingEm": -0.03,
        "weight": 600
      },
      {
        "label": "Title large",
        "token": "title-lg",
        "sizePx": 28,
        "lineHeightPx": 34,
        "lineHeight": 1.214,
        "letterSpacingEm": -0.022,
        "weight": 600
      },
      {
        "label": "Metric",
        "token": "metric",
        "sizePx": 28,
        "lineHeightPx": 32,
        "lineHeight": 1.143,
        "letterSpacingEm": -0.02,
        "weight": 600
      },
      {
        "label": "Title",
        "token": "title",
        "sizePx": 20,
        "lineHeightPx": 28,
        "lineHeight": 1.4,
        "letterSpacingEm": -0.015,
        "weight": 600
      },
      {
        "label": "Title small",
        "token": "title-sm",
        "sizePx": 17,
        "lineHeightPx": 24,
        "lineHeight": 1.412,
        "letterSpacingEm": -0.01,
        "weight": 600
      },
      {
        "label": "Body large",
        "token": "body-lg",
        "sizePx": 15,
        "lineHeightPx": 22,
        "lineHeight": 1.467,
        "letterSpacingEm": -0.005,
        "weight": 500
      },
      {
        "label": "Body",
        "token": "body",
        "sizePx": 14,
        "lineHeightPx": 20,
        "lineHeight": 1.429,
        "letterSpacingEm": 0,
        "weight": 400
      },
      {
        "label": "Small",
        "token": "small",
        "sizePx": 13,
        "lineHeightPx": 18,
        "lineHeight": 1.385,
        "letterSpacingEm": 0,
        "weight": 400
      },
      {
        "label": "Caption",
        "token": "caption",
        "sizePx": 12,
        "lineHeightPx": 16,
        "lineHeight": 1.333,
        "letterSpacingEm": 0,
        "weight": 500
      },
      {
        "label": "Micro",
        "token": "micro",
        "sizePx": 11,
        "lineHeightPx": 14,
        "lineHeight": 1.273,
        "letterSpacingEm": 0.01,
        "weight": 500
      }
    ],
    "scaleNote": "The interface scale. Body (14/20) is the default for everything interactive; 12px is the smallest readable text; micro is for keyboard keys and chart ticks only."
  },
  "logo": {
    "clearspaceMultiplier": 0.25,
    "clearspaceBasis": "mark-height",
    "minimumUiPx": 20,
    "minimumFaviconPx": 16,
    "minimumLockupWidthPx": 112,
    "minimumWordmarkWidthPx": 88,
    "markAsset": "../logo/svg/mark-current.svg",
    "wordmarkAsset": "../logo/svg/wordmark-current.svg",
    "lockupAsset": "../logo/svg/lockup-current.svg",
    "monochromeOnly": true,
    "ink": "#000000",
    "paper": "#ffffff"
  },
  "radius": {
    "control": "pill",
    "menu": 16,
    "menuItem": 10,
    "dialog": 20,
    "group": 14,
    "panel": 12,
    "note": "Single-line controls are pills; containers use concentric radii (outer = inner + inset). @logicplanes/kaeso-ui owns the full scale."
  },
  "motion": {
    "fastMs": 120,
    "mediumMs": 200,
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "overlayEasing": "cubic-bezier(0.16, 1, 0.3, 1)",
    "pageEnter": false,
    "autoplay": false,
    "reducedMotion": "keep only opacity changes up to 100ms; never delay feedback"
  },
  "controls": {
    "inputBackground": "raised",
    "inputTransparent": false,
    "defaultHeightPx": 36,
    "minimumTargetPx": 32,
    "minimumTargetCoarsePx": 44,
    "focusRingPx": 2
  },
  "spacing": {
    "basePx": 4,
    "steps": [2, 4, 6, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 96]
  },
  "favicon": {
    "glyphFill": {
      "favicon": 0.94,
      "android": 0.88,
      "appleTouch": 0.8
    },
    "light": "#000000",
    "dark": "#ffffff",
    "appleCanvas": "#ffffff"
  },
  "platformIcon": {
    "canvasPx": 1024,
    "insetPx": 184,
    "glyphPx": 656,
    "lightCanvas": "#ffffff",
    "lightMark": "#000000",
    "darkCanvas": "#000000",
    "darkMark": "#ffffff"
  }
}
