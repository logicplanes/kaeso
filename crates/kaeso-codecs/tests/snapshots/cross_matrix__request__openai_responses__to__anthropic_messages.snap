  "multi-turn-roles": {
    "body": {
      "max_tokens": 4096,
      "messages": [
        {
          "content": [
            {
              "text": "I'm visiting Lisbon in March. What should I pack?",
              "type": "text"
            }
          ],
          "role": "user"
        },
        {
          "content": [
            {
              "text": "Pack layers and a light rain jacket: March in Lisbon is mild but showery.",
              "type": "text"
            }
          ],
          "role": "assistant"
        },
        {
          "content": [
            {
              "text": "And what about shoes?",
              "type": "text"
            }
          ],
          "role": "user"
        },
        {
          "content": [
            {
              "text": "Bring comfortable walking shoes with good grip, because the cobblestones get slippery in the rain.",
              "type": "text"
            }
          ],
          "role": "assistant"
        },
        {
          "content": [
            {
              "text": "The user prefers metric units.",
              "type": "text"
            },
            {
              "cache_control": {
                "type": "ephemeral"
              },
              "text": "Is the sea warm enough to swim?",
              "type": "text"
            }
          ],
          "role": "user"
        }
      ],
      "model": "gpt-5.5",
      "system": [
        {
          "text": "You are a concise travel assistant.",
          "type": "text"
        },
        {
          "cache_control": {
            "type": "ephemeral"
          },
          "text": "Answer in at most two sentences.",
          "type": "text"
        }
      ]
    },
    "path": "/v1/messages"
  },
  "providers/xai/codex-gpt-history": {
    "body": {
      "max_tokens": 4096,
      "messages": [
        {
          "content": [
            {
              "text": "<environment_context>\n  <cwd>/home/user/project</cwd>\n  <shell>zsh</shell>\n  <current_date>2026-10-25</current_date>\n  <timezone>Europe/Berlin</timezone>\n</environment_context>",
              "type": "text"
            }
          ],
          "role": "user"
        },
        {
          "content": [
            {
              "text": "Search the web for what the Kaeso AI gateway is, in one sentence. Then create proof.txt containing OK using the shell and reply with its contents.",
              "type": "text"
            }
          ],
          "role": "user"
        },
        {
          "content": [
            {
              "text": "I’ll look up the Kaeso AI gateway, then write `proof.txt` in the workspace and report its contents.",
              "type": "text"
            }
          ],
          "role": "assistant"
        },
        {
          "content": [
            {
              "text": "The search result describes Kaeso as a self-hosted gateway with a single compatible API and controls for keys, routing, limits, and logs. I’m writing `OK` to `proof.txt` now.",
              "type": "text"
            }
          ],
          "role": "assistant"
        },
        {
          "content": [
            {
              "id": "call_8T8RbkBlHo4KilFkd28euzyo",
              "input": {
                "input": "const r = await tools.exec_command({cmd:\"printf 'OK' > proof.txt && cat proof.txt\",yield_time_ms:10000,max_output_tokens:1000});\ntext(r.output);\n"
              },
              "name": "exec",
              "type": "tool_use"
            }
          ],
          "role": "assistant"
        },
        {
          "content": [
            {
              "content": [
                {
                  "text": "Script completed\nWall time 0.1 seconds\nOutput:\n",
                  "type": "text"
                },
                {
                  "text": "OK",
                  "type": "text"
                }
              ],
              "tool_use_id": "call_8T8RbkBlHo4KilFkd28euzyo",
              "type": "tool_result"
            }
          ],
          "role": "user"
        },
        {
          "content": [
            {
              "text": "Kaeso is a self-hosted AI gateway that provides a unified API for managing keys, routing, limits, and logs. `proof.txt` contains: `OK`.",
              "type": "text"
            }
          ],
          "role": "assistant"
        },
        {
          "content": [
            {
              "text": "<model_switch>\nThe user was previously using a different model. Please continue the conversation according to the following instructions:\n\nYou are Codex, an agent based on Grok 4.7.\n</model_switch>",
              "type": "text"
            },
            {
              "text": "<collaboration_mode># Collaboration Mode: Default\n\nYou are now in Default mode.\n</collaboration_mode>",
              "type": "text"
            },
            {
              "cache_control": {
                "type": "ephemeral"
              },
              "text": "What did you write? Reply with only it.",
              "type": "text"
            }
          ],
          "role": "user"
        }
      ],
      "model": "grok-4.7",
      "output_config": {
        "effort": "medium"
      },
      "system": [
        {
          "text": "You are Codex, an agent based on GPT-6. You and the user share one workspace, and your job is to collaborate with them until their intended goal is completely handled.",
          "type": "text"
        },
        {
          "text": "<skills_instructions>\n## Skills\nA skill is a set of local instructions to follow that is stored in a `SKILL.md` file.\n</skills_instructions>",
          "type": "text"
        },
        {
          "text": "<multi_agent_role>You are `/root`, the primary agent in a team of agents collaborating to fulfill the user's goals.</multi_agent_role>",
          "type": "text"
        },
        {
          "cache_control": {
            "type": "ephemeral"
          },
          "text": "<multi_agent_mode>Any earlier instruction enabling proactive multi-agent delegation no longer applies. Do not spawn sub-agents.</multi_agent_mode>",
          "type": "text"
        }
      ],
      "thinking": {
        "display": "summarized",
        "type": "adaptive"
      },
      "tool_choice": {
        "disable_parallel_tool_use": false,
        "type": "auto"
      },
      "tools": [
        {
          "cache_control": {
            "type": "ephemeral"
          },
          "description": "Runs a command in a PTY, returning output or a session ID for ongoing interaction.",
          "input_schema": {
            "additionalProperties": false,
            "properties": {
              "cmd": {
                "description": "Shell command to execute.",
                "type": "string"
