                "type": "string"
              }
            },
            "required": [
              "cmd"
            ],
            "type": "object"
          },
          "name": "exec_command",
          "strict": false
        },
        {
          "name": "web_search",
          "type": "web_search_20250305"
        }
      ]
    },
    "path": "/v1/messages"
  },
