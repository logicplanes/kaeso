                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "participants": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "name",
              "date",
              "participants"
            ],
            "type": "object"
          },
          "strict": true
        },
        "type": "json_schema"
      }
    },
    "path": "/v1/chat/completions"
  },
