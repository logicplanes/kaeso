  "gemini-cli-turn": {
    "body": {
      "input": [
        {
          "content": [
            {
              "text": "<session_context>\nThis is the Gemini CLI. We are setting up the context for our chat.\nToday's date is Friday, November 27, 2026 (formatted according to the user's locale).\nMy operating system is: linux\nThe project's temporary directory is: /home/user/.gemini/tmp/project\n- **Workspace Directories:**\n  - /home/user/project\n- **Directory Structure:**\n\n/home/user/project/\n├───calc.py\n└───test_calc.py\n\n\n</session_context>",
              "type": "input_text"
            },
            {
              "text": "hi",
              "type": "input_text"
            }
          ],
          "role": "user"
        }
      ],
      "instructions": "You are Gemini CLI, an autonomous CLI agent specializing in software engineering tasks. You are currently operating in **Default** mode. Your primary goal is to help users safely and effectively.",
      "model": "gemini-3.5-flash",
      "reasoning": {
        "summary": "auto"
      },
      "store": false,
      "temperature": 1.0,
      "tools": [
        {
          "description": "Manages your narrative flow. Include `title` and `summary` only when starting a new Chapter (logical phase) or shifting strategic intent.",
          "name": "update_topic",
          "parameters": {
            "properties": {
              "strategic_intent": {
                "description": "A mandatory one-sentence statement of your immediate intent.",
                "type": "string"
              },
              "summary": {
                "description": "(OPTIONAL) A detailed summary (5-10 sentences) covering both the work completed in the previous topic and the strategic intent of the new topic. This is required when transitioning between topics to maintain continuity.",
                "type": "string"
              },
              "title": {
                "description": "The title of the new topic or chapter.",
                "type": "string"
              },
              "wait_for_previous": {
                "description": "Set to true to wait for all previously requested tools in this turn to complete before starting. Set to false (or omit) to run in parallel. Use true when this tool depends on the output of previous tools.",
                "type": "boolean"
              }
            },
            "required": [
              "strategic_intent"
            ],
            "type": "object"
          },
          "strict": false,
          "type": "function"
        },
        {
          "description": "Reads and returns the content of a specified file. If the file is large, the content will be truncated. The tool's response will clearly indicate if truncation has occurred and will provide details on how to read more of the file using the 'start_line' and 'end_line' parameters. Handles text, images (PNG, JPG, GIF, WEBP, SVG, BMP), audio files (MP3, WAV, AIFF, AAC, OGG, FLAC), and PDF files. For text files, it can read specific line ranges.",
          "name": "read_file",
          "parameters": {
            "properties": {
              "end_line": {
                "description": "Optional: The 1-based line number to end reading at (inclusive).",
                "minimum": 1,
                "type": "integer"
              },
              "file_path": {
                "description": "The path to the file to read.",
                "type": "string"
              },
              "start_line": {
                "description": "Optional: The 1-based line number to start reading from.",
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "file_path"
            ],
            "type": "object"
          },
          "strict": false,
          "type": "function"
        }
      ],
      "top_p": 0.95
    },
    "path": "/v1/responses"
  },
