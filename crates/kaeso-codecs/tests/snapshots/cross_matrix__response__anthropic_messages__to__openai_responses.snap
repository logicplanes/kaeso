  "recorded-thinking-enabled-budget": {
    "background": false,
    "completed_at": 1760000000,
    "created_at": 1760000000,
    "error": null,
    "id": "msg_011CfvjgR4tvemLvtmGDn8Wd",
    "incomplete_details": null,
    "instructions": null,
    "max_output_tokens": null,
