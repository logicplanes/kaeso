{
  "model": "gpt-5.5",
  "input": [
    {
      "role": "system",
      "content": "Extract the event information."
    },
    {
      "role": "user",
      "content": "Alice and Bob are going to a science fair on Friday."
    }
  ],
  "text": {
    "format": {
      "type": "json_schema",
      "name": "calendar_event",
      "description": "A calendar event extracted from text.",
      "schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "participants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "date",
          "participants"
        ],
        "additionalProperties": false
      },
      "strict": true
    }
  }
}
