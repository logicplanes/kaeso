{
  "model": "nvidia/nemotron-3.5-lightning-free",
  "messages": [
    {
      "role": "system",
      "content": "You are a concise travel assistant. Use the tools for live data."
    },
    {
      "role": "user",
      "content": "What's the weather in Paris right now? Use Celsius."
    }
  ],
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "get_weather",
        "description": "Get the current weather for a location.",
        "parameters": {
          "type": "object",
          "properties": {
            "location": {
              "type": "string",
              "description": "City and country, e.g. Paris, France"
            },
            "unit": {
              "type": "string",
              "enum": [
                "celsius",
                "fahrenheit"
              ]
            }
          },
          "required": [
            "location",
            "unit"
          ]
        }
      }
    }
  ],
  "tool_choice": "auto",
  "max_tokens": 1024,
  "stream": true,
  "stream_options": {
    "include_usage": true
  }
}
