{
  "model": "claude-opus-5-5",
  "max_tokens": 1024,
  "messages": [
    {
      "role": "user",
      "content": "Extract the key information from this email: John Smith (john@example.com) is interested in our Enterprise plan and wants to schedule a demo for next Tuesday at 2pm."
    }
  ],
  "output_config": {
    "format": {
      "type": "json_schema",
      "schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "plan_interest": {
            "type": "string"
          },
          "demo_requested": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "email",
          "plan_interest",
          "demo_requested"
        ],
        "additionalProperties": false
      }
    }
  }
}
