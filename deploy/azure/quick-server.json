{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Kaeso on one Azure virtual machine with the Compose package, Caddy, bundled ClickHouse and the updater. Docs at https://docs.kaeso.app/self-hosting/platforms/azure"
  },
  "parameters": {
    "domain": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "The domain Kaeso answers on, such as kaeso.example.com; point its CNAME record at the fqdn output. Empty uses the address Azure gives the server, under cloudapp.azure.com."
      }
    },
    "dnsLabel": {
      "type": "string",
      "defaultValue": "",
      "maxLength": 63,
      "metadata": {
        "description": "The server's name under <region>.cloudapp.azure.com: lowercase letters, digits and hyphens, unique in the region. Empty makes one from the resource group."
      }
    },
    "kaesoVersion": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "The Kaeso release to install, as major.minor.patch; empty installs the newest stable release."
      }
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_B2als_v2",
      "allowedValues": [
        "Standard_B2als_v2",
        "Standard_B2as_v2",
        "Standard_B4as_v2",
        "Standard_D2as_v5",
        "Standard_D4as_v5",
        "Standard_D2s_v5",
        "Standard_D4s_v5"
      ],
      "metadata": {
        "description": "An x64 size with at least 2 vCPUs and 4 GB of memory."
      }
    },
    "diskSizeGb": {
      "type": "int",
      "defaultValue": 40,
      "minValue": 30,
      "maxValue": 2048,
      "metadata": {
        "description": "OS disk in GB; request logs grow it."
      }
    },
    "diskType": {
      "type": "string",
      "defaultValue": "StandardSSD_LRS",
      "allowedValues": ["StandardSSD_LRS", "Premium_LRS"],
      "metadata": {
        "description": "The OS disk's kind."
      }
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "kaeso",
      "metadata": {
        "description": "The server's administrator, for SSH and the serial console."
      }
    },
    "authenticationType": {
      "type": "string",
      "defaultValue": "sshPublicKey",
      "allowedValues": ["sshPublicKey", "password"],
      "metadata": {
        "description": "How the administrator signs in: an SSH public key, or a password."
      }
    },
    "adminPasswordOrKey": {
      "type": "securestring",
      "metadata": {
        "description": "The administrator's SSH public key, or password."
      }
    },
    "sshSourceAddress": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "An address range allowed to reach SSH, such as 203.0.113.0/24; empty keeps port 22 closed. The setupLink output works without SSH."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Where the server runs; the resource group's region by default."
      }
    }
  },
  "variables": {
    "name": "kaeso",
    "ipName": "[format('{0}-ip', variables('name'))]",
    "dnsLabel": "[if(empty(parameters('dnsLabel')), format('kaeso-{0}', uniqueString(resourceGroup().id)), parameters('dnsLabel'))]",
    "versionFlag": "[if(empty(parameters('kaesoVersion')), '', format(' --version \"{0}\"', parameters('kaesoVersion')))]",
    "linuxConfiguration": {
      "disablePasswordAuthentication": true,
      "ssh": {
        "publicKeys": [
          {
            "path": "[format('/home/{0}/.ssh/authorized_keys', parameters('adminUsername'))]",
            "keyData": "[parameters('adminPasswordOrKey')]"
          }
        ]
      }
    },
    "webRules": [
      {
        "name": "http",
        "properties": {
          "description": "HTTP for the certificate and redirects",
          "priority": 100,
          "direction": "Inbound",
          "access": "Allow",
          "protocol": "Tcp",
          "sourceAddressPrefix": "Internet",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "*",
          "destinationPortRange": "80"
        }
      },
      {
        "name": "https",
        "properties": {
          "description": "HTTPS",
          "priority": 110,
          "direction": "Inbound",
          "access": "Allow",
          "protocol": "Tcp",
          "sourceAddressPrefix": "Internet",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "*",
          "destinationPortRange": "443"
        }
      },
      {
        "name": "http3",
        "properties": {
          "description": "HTTP/3",
          "priority": 120,
          "direction": "Inbound",
          "access": "Allow",
          "protocol": "Udp",
          "sourceAddressPrefix": "Internet",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "*",
          "destinationPortRange": "443"
        }
      }
    ],
    "sshRule": [
      {
        "name": "ssh",
        "properties": {
          "description": "SSH from the allowed range",
          "priority": 130,
          "direction": "Inbound",
          "access": "Allow",
          "protocol": "Tcp",
          "sourceAddressPrefix": "[parameters('sshSourceAddress')]",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "*",
          "destinationPortRange": "22"
        }
      }
    ]
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2025-05-01",
      "name": "[format('{0}-nsg', variables('name'))]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": "[if(empty(parameters('sshSourceAddress')), variables('webRules'), concat(variables('webRules'), variables('sshRule')))]"
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2025-05-01",
      "name": "[format('{0}-vnet', variables('name'))]",
      "location": "[parameters('location')]",
      "dependsOn": ["[resourceId('Microsoft.Network/networkSecurityGroups', format('{0}-nsg', variables('name')))]"],
      "properties": {
        "addressSpace": {
          "addressPrefixes": ["10.83.0.0/24"]
        },
        "subnets": [
          {
            "name": "default",
            "properties": {
              "addressPrefix": "10.83.0.0/24",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', format('{0}-nsg', variables('name')))]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2025-05-01",
      "name": "[variables('ipName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "publicIPAddressVersion": "IPv4",
        "dnsSettings": {
          "domainNameLabel": "[variables('dnsLabel')]"
        }
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2025-05-01",
      "name": "[format('{0}-nic', variables('name'))]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', format('{0}-vnet', variables('name')))]",
        "[resourceId('Microsoft.Network/publicIPAddresses', variables('ipName'))]"
      ],
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', format('{0}-vnet', variables('name')), 'default')]"
              },
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('ipName'))]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2025-04-01",
      "name": "[variables('name')]",
      "location": "[parameters('location')]",
      "dependsOn": ["[resourceId('Microsoft.Network/networkInterfaces', format('{0}-nic', variables('name')))]"],
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('vmSize')]"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "ubuntu-24_04-lts",
            "sku": "server",
            "version": "latest"
          },
          "osDisk": {
            "createOption": "FromImage",
            "diskSizeGB": "[parameters('diskSizeGb')]",
            "deleteOption": "Delete",
            "managedDisk": {
              "storageAccountType": "[parameters('diskType')]"
            }
          }
        },
        "osProfile": {
          "computerName": "[variables('name')]",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPasswordOrKey')]",
          "linuxConfiguration": "[if(equals(parameters('authenticationType'), 'password'), null(), variables('linuxConfiguration'))]"
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', format('{0}-nic', variables('name')))]",
              "properties": {
                "deleteOption": "Delete"
              }
            }
          ]
        },
        "securityProfile": {
          "securityType": "TrustedLaunch",
          "uefiSettings": {
            "secureBootEnabled": true,
            "vTpmEnabled": true
          }
        },
        "diagnosticsProfile": {
          "bootDiagnostics": {
            "enabled": true
          }
        }
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2025-04-01",
      "name": "[format('{0}/install', variables('name'))]",
      "location": "[parameters('location')]",
      "dependsOn": ["[resourceId('Microsoft.Compute/virtualMachines', variables('name'))]"],
      "properties": {
        "publisher": "Microsoft.Azure.Extensions",
        "type": "CustomScript",
        "typeHandlerVersion": "2.1",
        "autoUpgradeMinorVersion": true,
        "protectedSettings": {
          "commandToExecute": "[format('bash -c ''set -euo pipefail; curl -fsSL https://kaeso.app/install.sh | sh -s -- --domain \"{0}\" --dir /opt/kaeso --install-docker --no-open{1}''', if(empty(parameters('domain')), reference(resourceId('Microsoft.Network/publicIPAddresses', variables('ipName')), '2025-05-01').dnsSettings.fqdn, parameters('domain')), variables('versionFlag'))]"
        }
      }
    }
  ],
  "outputs": {
    "url": {
      "type": "string",
      "metadata": {
        "description": "Where Kaeso answers once the certificate is issued, a minute or two after the server is up."
      },
      "value": "[uri(format('https://{0}', if(empty(parameters('domain')), reference(resourceId('Microsoft.Network/publicIPAddresses', variables('ipName')), '2025-05-01').dnsSettings.fqdn, parameters('domain'))), '/')]"
    },
    "fqdn": {
      "type": "string",
      "metadata": {
        "description": "The server's address under cloudapp.azure.com; point your domain's CNAME record at it."
      },
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', variables('ipName')), '2025-05-01').dnsSettings.fqdn]"
    },
    "publicIp": {
      "type": "string",
      "metadata": {
        "description": "The server's address, for an A record instead of a CNAME."
      },
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', variables('ipName')), '2025-05-01').ipAddress]"
    },
    "setupLink": {
      "type": "string",
      "metadata": {
        "description": "Prints the one-time setup link with the Azure CLI, without SSH; the install's folder is /opt/kaeso."
      },
      "value": "[format('az vm run-command invoke --resource-group {0} --name {1} --command-id RunShellScript --scripts \"cd /opt/kaeso && docker compose exec -T gateway kaeso setup-link\" --query \"value[0].message\" --output tsv', resourceGroup().name, variables('name'))]"
    }
  }
}
