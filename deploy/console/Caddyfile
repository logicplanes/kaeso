{
	admin off
	auto_https off
	persist_config off
}

# KAESO_SEARCH_ENGINES, which serve.sh turns into true or false, imports one of these two.
(search-engines-false) {
	header X-Robots-Tag "noindex, nofollow"
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "public, max-age=3600"
		respond <<TXT
			User-agent: *
			Disallow: /

			TXT 200
	}
}

# The sign-in page without a query, and the files that draw it, are the only answers without noindex,
# and the only ones robots.txt allows. A query's `next` names another page; the sign-up page isn't one,
# since only the Platform API, which crawlers may not fetch, says whether it is open.
(search-engines-true) {
	@noindex not expression `(path('/sign-in') && {query} == '') || (path('/assets/*', '/theme-init.js', '/favicon*', '/apple-touch-icon.png') && file())`
	header @noindex X-Robots-Tag "noindex, nofollow"
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "public, max-age=3600"
		respond <<TXT
			User-agent: *
			Allow: /sign-in$
			Allow: /assets/
			Allow: /theme-init.js
			Allow: /favicon
			Allow: /apple-touch-icon.png
			Disallow: /

			TXT 200
	}
}

:3000 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; require-trusted-types-for 'script'"
		-Server
	}

	import search-engines-{$KAESO_SEARCH_ENGINES:false}

	handle /healthz {
		header Cache-Control "no-store"
		respond "ok" 200
	}

	handle /assets/* {
		@hashed file
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# A shared link's page, with the link's preview image in its Open Graph tags. Never indexed,
	# whatever KAESO_SEARCH_ENGINES says: a link is meant for the people it is sent to.
	@share path_regexp share ^/share/([A-Za-z0-9_-]{43})$
	handle @share {
		header Cache-Control "no-store"
		header X-Robots-Tag "noindex, nofollow"
		rewrite * /share.html
		templates
		file_server
	}

	# Templates write the page's robots meta tag from its X-Robots-Tag header.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		templates {
			mime text/html
		}
		file_server
	}
}
