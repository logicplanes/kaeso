{
  "name": "kaeso",
  "version": "0.4.6",
  "private": true,
  "description": "Kaeso, the open-source, self-hosted AI gateway: the TypeScript workspace of the console, the documentation and the UI library.",
  "license": "MIT",
  "author": "Devin Oldenburg",
  "homepage": "https://kaeso.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logicplanes/kaeso.git"
  },
  "bugs": {
    "url": "https://github.com/logicplanes/kaeso/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "dev": "pnpm build:packages && pnpm stack:up && pnpm --filter kaeso-console dev",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test && node --test 'scripts/*.test.mjs'",
    "i18n": "pnpm -r --if-present i18n",
    "knip": "pnpm build:packages && pnpm --filter kaeso-console generate && pnpm --filter kaeso-showcase gen && knip",
    "licenses:check": "node scripts/licenses.mjs && pnpm -r --if-present licenses:check",
    "release:check": "node scripts/check-pack.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "e2e": "pnpm -r --workspace-concurrency=1 --if-present e2e",
    "stack:up": "pnpm --filter kaeso-console stack:up",
    "stack:down": "pnpm --filter kaeso-console stack:down",
    "seed": "pnpm --filter kaeso-console seed",
    "demo": "pnpm --filter kaeso-console demo"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "knip": "6.41.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "semver": "7.8.5"
  }
}
