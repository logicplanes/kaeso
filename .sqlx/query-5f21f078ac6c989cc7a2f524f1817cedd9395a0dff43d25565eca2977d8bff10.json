  "query": "UPDATE organizations o SET metadata_retention_days = LEAST(old.metadata_retention_days, $1), content_retention_days = LEAST(old.content_retention_days, $2, old.metadata_retention_days, $1), updated_at = now() FROM organizations old WHERE old.id = o.id AND (old.metadata_retention_days > $1 OR old.content_retention_days > $2) RETURNING o.id, old.metadata_retention_days AS metadata_before, o.metadata_retention_days, old.content_retention_days AS content_before, o.content_retention_days",
