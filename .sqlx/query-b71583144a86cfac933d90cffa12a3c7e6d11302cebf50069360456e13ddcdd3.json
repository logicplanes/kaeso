  "db_name": "PostgreSQL",
  "query": "SELECT g.id, g.org_id, g.project_id, g.api_key_id, g.user_id, g.service_account_id, g.provider, g.credential_id, g.catalogue_model_id, g.model, g.upstream_model, g.dialect, g.upstream_id, g.request_id, g.params, g.prices, g.status, g.content_url, g.content_mime_type, g.failure_reason, g.error_message, g.units, g.cost, g.created_at, g.completed_at, g.accounted_at FROM image_generations g LEFT JOIN image_generations b ON b.org_id = $1 AND b.project_id = $2 AND b.id = $3 WHERE g.org_id = $1 AND g.project_id = $2 AND ($3::uuid IS NULL OR (g.created_at, g.id) < (b.created_at, b.id)) AND ($4::text IS NULL OR g.status = $4) AND ($5::text IS NULL OR g.model = $5) ORDER BY g.created_at DESC, g.id DESC LIMIT $6",
