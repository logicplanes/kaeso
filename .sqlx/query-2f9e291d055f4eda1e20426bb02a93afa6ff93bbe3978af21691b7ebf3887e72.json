  "query": "SELECT m.id, m.project_id, m.user_id, u.email, u.name, m.preset, m.role_id, m.rights_added, m.rights_removed, r.name AS \"role_name?\", r.rights AS \"role_rights?\", r.project_rights AS \"role_project_rights?\", m.created_at, u.avatar FROM project_memberships m JOIN users u ON u.id = m.user_id LEFT JOIN org_roles r ON r.id = m.role_id WHERE m.project_id = $1 AND ($2::uuid IS NULL OR m.id > $2) ORDER BY m.id LIMIT $3",
