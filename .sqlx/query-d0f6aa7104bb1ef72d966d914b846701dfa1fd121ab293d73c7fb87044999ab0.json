  "query": "SELECT s.id, s.project_id, s.name, s.preset, s.role_id, s.rights_added, s.rights_removed, r.name AS \"role_name?\", r.rights AS \"role_rights?\", r.project_rights AS \"role_project_rights?\", s.created_by, s.archived_at, s.created_at FROM service_accounts s LEFT JOIN org_roles r ON r.id = s.role_id WHERE s.project_id = $1 AND ($2 OR s.archived_at IS NULL) AND ($3::uuid IS NULL OR s.id > $3) ORDER BY s.id LIMIT $4",
