  "query": "SELECT c.id, c.ciphertext, c.nonce, c.wrapped_key, c.key_id, c.revision, c.auth_method, c.expires_at, c.auth_error, c.location, c.account_id, c.gateway_id, c.endpoint, c.spend_limited_until, (SELECT a.send_billing_policy FROM linked_billing_apps a WHERE a.provider = c.provider) AS billing_policy FROM provider_credentials c WHERE c.org_id = $1 AND c.provider = $3 AND c.id = $4 AND ( EXISTS (SELECT 1 FROM project_provider_keys a WHERE a.credential_id = c.id AND a.project_id = $2) OR (c.is_default AND NOT EXISTS ( SELECT 1 FROM project_provider_keys a WHERE a.project_id = $2 AND a.provider = $3)) OR EXISTS (SELECT 1 FROM linked_billing_fallbacks f WHERE f.project_id = $2 AND f.provider = $3 AND f.credential_id = c.id))",
