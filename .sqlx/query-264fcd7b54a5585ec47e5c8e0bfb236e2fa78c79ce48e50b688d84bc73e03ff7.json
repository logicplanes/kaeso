{
  "db_name": "PostgreSQL",
  "query": "SELECT r.id, r.org_id, r.scope, r.name, r.description, r.rights, r.project_rights, r.created_by, r.created_at, r.updated_at, ((SELECT count(*) FROM org_memberships m WHERE m.role_id = r.id) + (SELECT count(*) FROM project_memberships m WHERE m.role_id = r.id) + (SELECT count(*) FROM service_accounts s WHERE s.role_id = r.id AND s.archived_at IS NULL) + (SELECT count(*) FROM invites i WHERE i.org_role_id = r.id AND i.accepted_at IS NULL AND i.revoked_at IS NULL AND i.expires_at > now())) AS \"holders!\" FROM org_roles r WHERE r.org_id = $1 ORDER BY r.scope, lower(r.name)",
