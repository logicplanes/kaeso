{
  "db_name": "PostgreSQL",
  "query": "SELECT v.id, v.org_id, v.project_id, v.api_key_id, v.user_id, v.service_account_id, v.provider, v.credential_id, v.catalogue_model_id, v.model, v.upstream_model, v.dialect, v.upstream_id, v.request_id, v.params, v.prices, v.status, v.progress, v.error, v.remixed_from, v.units, v.cost, v.created_at, v.completed_at, v.expires_at, v.accounted_at FROM videos v LEFT JOIN videos a ON a.org_id = $1 AND a.project_id = $2 AND a.id = $3 WHERE v.org_id = $1 AND v.project_id = $2 AND ($3::uuid IS NULL OR ( CASE WHEN $4 THEN (v.created_at, v.id) > (a.created_at, a.id) ELSE (v.created_at, v.id) < (a.created_at, a.id) END)) ORDER BY CASE WHEN $4 THEN v.created_at END ASC, CASE WHEN $4 THEN v.id END ASC, CASE WHEN NOT $4 THEN v.created_at END DESC, CASE WHEN NOT $4 THEN v.id END DESC LIMIT $5",
