  "db_name": "PostgreSQL",
  "query": "SELECT k.id, k.name, k.org_id, CASE WHEN k.created_by_kind = 'user' THEN k.created_by_id END AS created_by, k.expires_at AS \"expires_at!\" FROM org_platform_keys k JOIN organizations o ON o.id = k.org_id WHERE k.archived_at IS NULL AND k.disabled_at IS NULL AND k.replaced_by IS NULL AND o.state = 'active' AND k.expires_at > $1 AND k.expires_at <= $1 + make_interval(days => $2) AND NOT EXISTS (SELECT 1 FROM platform_key_expiry_warnings w WHERE w.key_id = k.id AND w.days_before = $2)",
