  "query": "INSERT INTO linked_billing_apps AS l (provider, client_id, audience, organization_id, federation_rule_id, workspace_id, service_account_id, send_billing_policy, updated_by) VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) ON CONFLICT (provider) DO UPDATE SET client_id = EXCLUDED.client_id, audience = EXCLUDED.audience, organization_id = EXCLUDED.organization_id, federation_rule_id = EXCLUDED.federation_rule_id, workspace_id = EXCLUDED.workspace_id, service_account_id = EXCLUDED.service_account_id, send_billing_policy = EXCLUDED.send_billing_policy, updated_by = EXCLUDED.updated_by, updated_at = now(), check_profile_id = CASE WHEN l.client_id = EXCLUDED.client_id AND l.organization_id = EXCLUDED.organization_id THEN l.check_profile_id END, checked_at = NULL, check_problem = NULL RETURNING provider, client_id, audience, organization_id, federation_rule_id, workspace_id, service_account_id, send_billing_policy, check_profile_id, checked_at, check_problem, updated_by, updated_at",
