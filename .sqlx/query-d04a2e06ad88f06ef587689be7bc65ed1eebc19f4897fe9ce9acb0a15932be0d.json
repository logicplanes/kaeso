  "query": "SELECT r.id, r.client_id, c.name AS client_name, c.software_id, r.redirect_uri, r.state, r.code_challenge, r.expires_at, r.resource FROM agent_requests r JOIN agent_clients c ON c.id = r.client_id WHERE r.token_hash = $1 AND r.used_at IS NULL AND r.expires_at > $2",
