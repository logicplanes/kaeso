  "query": "SELECT a.id, a.user_id, a.client_id, a.name, a.model, a.preset, a.customized, a.instance_rights, a.account_rights, a.future_orgs, a.future_org_rights, a.future_project_rights, a.sign_in_method, a.second_factor, a.oidc_org_id, a.created_at, a.last_used_at, a.revoked_at, t.expires_at AS token_expires_at, u.state AS user_state, u.is_instance_admin FROM agent_tokens t JOIN agents a ON a.id = t.agent_id JOIN users u ON u.id = a.user_id WHERE t.token_hash = $1 AND t.kind = 'access' AND t.revoked_at IS NULL AND a.revoked_at IS NULL AND (t.expires_at IS NULL OR t.expires_at > $2)",
