  "db_name": "PostgreSQL",
  "query": "SELECT g.id AS grant_id, g.user_id, g.org_id, g.project_id, g.client_id, c.name AS client_name, t.resource, t.expires_at AS token_expires_at, u.state AS user_state FROM portal_tokens t JOIN portal_grants g ON g.id = t.grant_id JOIN agent_clients c ON c.id = g.client_id JOIN users u ON u.id = g.user_id WHERE t.token_hash = $1 AND t.kind = 'access' AND t.revoked_at IS NULL AND g.revoked_at IS NULL AND (t.expires_at IS NULL OR t.expires_at > $2)",
