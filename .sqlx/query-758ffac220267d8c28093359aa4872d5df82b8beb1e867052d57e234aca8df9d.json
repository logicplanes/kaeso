  "db_name": "PostgreSQL",
  "query": "SELECT id, org_id, project_id, actor_kind, actor_id, action, target_kind, target_id, before, after, ip, user_agent, request_id, at FROM audit_events WHERE (($1::uuid IS NULL AND scope = 'instance') OR (scope = 'org' AND org_id = $1)) AND ($2::uuid IS NULL OR id < $2) AND ($4::uuid IS NULL OR actor_id = $4) AND ($5::text IS NULL OR action LIKE $5) AND ($6::text IS NULL OR target_id = $6) AND ($7::timestamptz IS NULL OR at >= $7) AND ($8::timestamptz IS NULL OR at < $8) AND ($9::uuid IS NULL OR project_id = $9) ORDER BY id DESC LIMIT $3",
