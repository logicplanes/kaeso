  "query": "SELECT t.id, t.agent_id, t.family, t.redirect_uri, t.code_challenge, a.client_id FROM agent_tokens t JOIN agents a ON a.id = t.agent_id WHERE t.token_hash = $1 AND t.kind = $2 AND t.revoked_at IS NULL AND a.revoked_at IS NULL AND (t.expires_at IS NULL OR t.expires_at > $3)",
