  "query": "SELECT a.credential_id, a.project_id, p.name AS project_name, p.avatar AS project_avatar FROM project_provider_keys a JOIN projects p ON p.id = a.project_id WHERE a.org_id = $1 AND ($2::uuid IS NULL OR a.credential_id = $2) ORDER BY lower(p.name), p.id",
