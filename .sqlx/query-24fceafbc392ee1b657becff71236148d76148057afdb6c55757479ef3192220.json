  "query": "SELECT b.id, b.org_id, b.project_id, b.api_key_id, b.user_id, b.service_account_id, b.credential_id, b.provider, b.upstream_id, b.input_file_id, b.output_file_id, b.error_file_id, b.endpoint, b.catalogue_model_id, b.model, b.upstream_model, b.prices, b.metadata, b.status, b.view, b.created_at, b.accounted_at FROM batches b WHERE b.org_id = $1 AND b.project_id = $2 AND ($3::uuid IS NULL OR (b.created_at, b.id) < ( SELECT a.created_at, a.id FROM batches a WHERE a.project_id = $2 AND a.id = $3)) ORDER BY b.created_at DESC, b.id DESC LIMIT $4",
