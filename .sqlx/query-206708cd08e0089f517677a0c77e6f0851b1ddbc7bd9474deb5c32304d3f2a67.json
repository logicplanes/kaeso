  "query": "SELECT g.id, g.user_id, g.org_id, g.project_id, g.client_id, c.name AS client_name, g.redirect_uri, g.created_at, g.last_used_at, g.revoked_at FROM portal_grants g JOIN agent_clients c ON c.id = g.client_id WHERE g.user_id = $1 AND g.revoked_at IS NULL ORDER BY g.created_at DESC, g.id",
