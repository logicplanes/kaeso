  "query": "SELECT c.id, c.tool_id, t.name AS tool_name, c.from_hash, c.to_hash, c.detected_at, c.outcome, c.decided_by_kind, c.decided_by_id, c.decided_at FROM mcp_tool_changes c JOIN mcp_tools t ON t.id = c.tool_id WHERE c.org_id = $1 AND c.server_id = $2 AND ($3::uuid IS NULL OR (c.detected_at, c.id) < (SELECT p.detected_at, p.id FROM mcp_tool_changes p WHERE p.id = $3 AND p.server_id = $2)) ORDER BY c.detected_at DESC, c.id DESC LIMIT $4",
