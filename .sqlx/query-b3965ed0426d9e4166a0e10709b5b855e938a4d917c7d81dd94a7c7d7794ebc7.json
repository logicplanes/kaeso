  "query": "SELECT t.id, t.server_id, t.org_id, t.name, t.title, t.description, t.input_schema, t.output_schema, t.annotations, t.meta, t.definition_hash, t.approved_hash, t.approved, t.state, t.first_seen_at, t.changed_at, t.updated_at, s.handle AS server_handle, s.name AS server_name, COALESCE(pt.enabled, false) AS \"enabled!\", COALESCE(pt.confirm, false) AS \"confirm!\" FROM project_mcp_servers ps JOIN mcp_servers s ON s.id = ps.server_id JOIN mcp_tools t ON t.server_id = ps.server_id LEFT JOIN project_tools pt ON pt.project_id = ps.project_id AND pt.tool_id = t.id WHERE ps.project_id = $1 AND t.state <> 'removed' ORDER BY s.handle, t.name",
