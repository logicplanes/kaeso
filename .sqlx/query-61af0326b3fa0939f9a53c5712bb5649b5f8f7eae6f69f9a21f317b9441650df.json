{
  "db_name": "PostgreSQL",
  "query": "SELECT a.id, a.name, a.harness, a.model, a.user_id, u.name AS user_name, u.email AS user_email, u.avatar AS user_avatar, a.created_at, a.last_used_at, a.expires_at FROM agents a JOIN org_memberships m ON m.user_id = a.user_id AND m.org_id = $1 JOIN users u ON u.id = a.user_id LEFT JOIN agent_orgs ao ON ao.agent_id = a.id AND ao.org_id = $1 WHERE a.revoked_at IS NULL AND (a.expires_at IS NULL OR a.expires_at > $2) AND (ao.included OR (ao.agent_id IS NULL AND a.future_orgs)) ORDER BY a.id DESC",
