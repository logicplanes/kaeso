  "db_name": "PostgreSQL",
  "query": "SELECT p.id, p.org_id, p.name, p.is_default, p.content_logging, p.max_key_lifetime_days, p.archived_at, p.created_at, p.avatar FROM projects p WHERE p.org_id = $1 AND ($2::uuid IS NULL OR EXISTS (SELECT 1 FROM project_memberships m WHERE m.project_id = p.id AND m.user_id = $2)) AND ($3 OR p.archived_at IS NULL) AND ($4::uuid IS NULL OR p.id > $4) ORDER BY p.id LIMIT $5",
