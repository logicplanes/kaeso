  "query": "SELECT m.user_id, m.preset, m.role_id, m.rights_added, m.rights_removed, r.name AS \"role_name?\", r.rights AS \"role_rights?\", r.project_rights AS \"role_project_rights?\", pm.preset AS \"p_preset?\", pm.role_id AS \"p_role_id?\", pm.rights_added AS \"p_rights_added?\", pm.rights_removed AS \"p_rights_removed?\", pr.name AS \"p_role_name?\", pr.rights AS \"p_role_rights?\", pr.project_rights AS \"p_role_project_rights?\" FROM org_memberships m LEFT JOIN org_roles r ON r.id = m.role_id LEFT JOIN project_memberships pm ON pm.user_id = m.user_id AND pm.project_id = $2 LEFT JOIN org_roles pr ON pr.id = pm.role_id WHERE m.org_id = $1 ORDER BY m.id",
