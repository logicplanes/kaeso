{
  "db_name": "PostgreSQL",
  "query": "SELECT e.id, e.org_id, e.project_id, e.actor_kind, e.actor_id, e.agent_id, a.name AS \"agent_name?\", a.model AS \"agent_model?\", e.action, e.target_kind, e.target_id, e.before, e.after, e.ip, e.user_agent, e.request_id, e.at FROM audit_events e LEFT JOIN agents a ON a.id = e.agent_id WHERE (($1::uuid IS NULL AND e.scope = 'instance') OR (e.scope = 'org' AND e.org_id = $1)) AND ($2::uuid IS NULL OR e.id < $2) AND ($4::uuid IS NULL OR e.actor_id = $4) AND ($5::text IS NULL OR e.action LIKE $5) AND ($6::text IS NULL OR e.target_id = $6) AND ($7::timestamptz IS NULL OR e.at >= $7) AND ($8::timestamptz IS NULL OR e.at < $8) AND ($9::uuid IS NULL OR e.project_id = $9) AND (NOT $10 OR e.actor_kind = 'agent') ORDER BY e.id DESC LIMIT $3",
