  "query": "SELECT t.id, t.grant_id, t.family, t.resource, t.redirect_uri, t.code_challenge, g.client_id FROM portal_tokens t JOIN portal_grants g ON g.id = t.grant_id WHERE t.token_hash = $1 AND t.kind = $2 AND t.revoked_at IS NULL AND g.revoked_at IS NULL AND (t.expires_at IS NULL OR t.expires_at > $3)",
