  "query": "SELECT o.id AS org_id, o.name AS org_name, c.display_name AS provider_name, i.linked_at FROM org_memberships m JOIN organizations o ON o.id = m.org_id JOIN org_oidc c ON c.org_id = m.org_id LEFT JOIN sso_identities i ON i.org_id = m.org_id AND i.user_id = m.user_id AND i.issuer = c.issuer WHERE m.user_id = $1 ORDER BY o.name, o.id",
