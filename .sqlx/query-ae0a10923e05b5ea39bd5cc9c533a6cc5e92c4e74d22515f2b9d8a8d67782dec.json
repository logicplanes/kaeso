  "query": "SELECT id, org_id, email, org_preset, org_role_id, project_roles, invited_by, expires_at, accepted_at, revoked_at, created_at FROM invites WHERE org_id IS NOT DISTINCT FROM $1 AND (NOT $2 OR (accepted_at IS NULL AND revoked_at IS NULL AND expires_at > $3)) AND ($4::uuid IS NULL OR id > $4) ORDER BY id LIMIT $5",
