{
  "db_name": "PostgreSQL",
  "query": "SELECT k.id, k.secret_hash, k.org_id, o.state AS org_state, k.project_id, p.archived_at AS project_archived_at, k.user_id, u.state AS \"user_state?\", k.service_account_id, s.archived_at AS \"service_account_archived_at?\", k.inference, k.platform, k.expires_at, k.disabled_at, k.archived_at, k.last_used_at, om.preset AS \"org_preset?\", COALESCE(om.rights_added, '{}') AS \"org_rights_added!\", COALESCE(om.rights_removed, '{}') AS \"org_rights_removed!\", om.role_id AS \"org_role_id?\", orr.rights AS \"org_role_rights?\", orr.project_rights AS \"org_role_project_rights?\", COALESCE(pm.preset, s.preset) AS \"project_preset?\", COALESCE(pm.role_id, s.role_id) AS \"project_role_id?\", prr.rights AS \"project_role_rights?\", COALESCE(pm.rights_added, s.rights_added, '{}') AS \"project_rights_added!\", COALESCE(pm.rights_removed, s.rights_removed, '{}') AS \"project_rights_removed!\" FROM api_keys k JOIN organizations o ON o.id = k.org_id JOIN projects p ON p.id = k.project_id LEFT JOIN users u ON u.id = k.user_id LEFT JOIN service_accounts s ON s.id = k.service_account_id LEFT JOIN org_memberships om ON om.org_id = k.org_id AND om.user_id = k.user_id LEFT JOIN project_memberships pm ON pm.project_id = k.project_id AND pm.user_id = k.user_id LEFT JOIN org_roles orr ON orr.id = om.role_id LEFT JOIN org_roles prr ON prr.id = COALESCE(pm.role_id, s.role_id) WHERE k.secret_hash = $1",
